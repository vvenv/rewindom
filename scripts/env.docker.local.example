# 本地完整 Docker 栈（生产镜像验证）— 复制为 .env.docker.local（勿提交）
# 与日常开发（pnpm db:up + pnpm dev）分离；发布前可选验证用
#
# 用法:
#   cp scripts/env.docker.local.example .env.docker.local
#   pnpm docker:stack:up
#   open http://localhost:3700

DB_PASSWORD=dev-password
JWT_SECRET=your-random-secret-key-at-least-32-characters-long
TENANT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 单租户部署（默认关闭）；验证时与 docker-compose.prod.yml 透传一致
# SINGLE_TENANT=true

APP_DOMAIN=localhost
APP_PORT=3700
FRONTEND_URL=http://localhost:3700

LOG_LEVEL=info

# OPENAI_API_KEY=
# REDIS_PASSWORD=
