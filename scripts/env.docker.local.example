# 本地完整 Docker 栈（生产镜像验证）— 复制为 .env.docker.local（勿提交）
# 与日常开发（pnpm db:up + pnpm dev）分离；发布前可选验证用
#
# 用法:
#   cp scripts/env.docker.local.example .env.docker.local
#   pnpm docker:stack:up
#   open http://localhost:3700
#
# 变量按模块分块：deploy → kernel → user → platform → billing → shop → events

# ── deploy ────────────────────────────────────────────────────
APP_DOMAIN=localhost
APP_PORT=3700
PLATFORM_HOST=127.0.0.1

# ── kernel ────────────────────────────────────────────────────
DB_PASSWORD=dev-password
JWT_SECRET=your-random-secret-key-at-least-32-characters-long
TENANT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 单租户部署（默认关闭）；验证时与 docker-compose.prod.yml 透传一致
# SINGLE_TENANT=true

FRONTEND_URL=http://localhost:3700
PLATFORM_URL=http://127.0.0.1:3700
LOG_LEVEL=info

# OPENAI_API_KEY=
# REDIS_PASSWORD=

# 文件存储（默认本地 /data/attachments）。验证 R2 时：
# ATTACHMENT_STORAGE=r2
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# ── user ──────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── platform ──────────────────────────────────────────────────
# PLATFORM_ADMIN_USERNAME=platform
# PLATFORM_ADMIN_PASSWORD=change-me-in-production

# ── billing ───────────────────────────────────────────────────
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=

# ── shop ──────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ── events ────────────────────────────────────────────────────
# EVENTS_INGEST_ENABLED=true
# EVENTS_ANALYZER=auto
