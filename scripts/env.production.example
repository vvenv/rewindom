# 生产环境 — 复制为仓库根目录 .env.production（勿提交）
# 本机：SSH 凭证 + Docker 部署密钥；服务器：由部署脚本写入对应 .env.production
#
# 变量按模块分块：deploy → kernel → user → platform → billing → shop → events

# ── deploy（本机 SSH，永不上传服务器） ────────────────────────
DEPLOY_HOST=123.45.67.89
DEPLOY_SSH_USER=root
DEPLOY_SSH_PASSWORD=your-password

APP_DOMAIN=rewindom.example.com
APP_PORT=3700
SSL_EMAIL=you@example.com
# 产品站 = 默认租户 CMS（Host 隐式绑定 default）。平台控制台必须另 Host。
# PLATFORM_URL / PLATFORM_HOST 默认 admin.${APP_DOMAIN}（需 DNS + 证书）。
# PLATFORM_URL=https://admin.rewindom.example.com
# PLATFORM_HOST=admin.rewindom.example.com

# ── kernel ────────────────────────────────────────────────────
# 公开面（官网 SSR）的 CSP：off / report / enforce。
# 默认 report——只把违规报到浏览器控制台，不拦任何东西。与限流的 log_only 同理：
# 策略配错会把整站脚本拦掉，比它防的问题严重。切 enforce 前先看几天真实违规，
# 用了 Google Tag Manager 的站点尤其要看（容器里可再装任意第三方标签）。
# 应用壳层（/app、/platform）的 CSP 是构建期生成的，一直是 enforce，与这项无关。
SITE_CSP_MODE=report
# 应用密钥（首次部署必填）
DB_PASSWORD=your-db-password
JWT_SECRET=your-64-char-random-jwt-secret
TENANT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 可信反向代理 —— 决定 request.ip 取 X-Forwarded-For 的哪一跳。
# compose 默认 uniquelocal（私网网段），适用于「宿主 nginx → 容器 nginx → app」。
# 外层是公网出口的云 LB 时必须改成该 LB 的实际网段；写成 true / 0.0.0.0/0 等于
# 允许任何人用一行请求头伪造自己的 IP，按 IP 的限流与封禁全部失效。
# TRUSTED_PROXIES=uniquelocal

# ── IP 访问控制（module-ip-access） ───────────────────────────
# 关掉判定（名单还在，只是不拦）
# IP_ACCESS_ENABLED=false
# 永远放行的豁免名单，压过一切封禁规则。逗号分隔 CIDR。
# 至少写上：监控探针、健康检查来源、CDN 回源段、支付回调源、自己的办公出口。
# 留空 = 一条过宽的规则就能把你自己锁在后台外面，而那时你已经改不了规则了。
# IP_ACCESS_ALWAYS_ALLOW=203.0.113.10/32,198.51.100.0/24
# 站点在 Cloudflare 橙云后面时设为 true：把 CF 官方网段并入可信代理。
# 不设的话到达 origin 的每个请求的 client IP 都是 CF 边缘节点，
# 按 IP 的封禁与限流全部失真，审计日志的 IP 也是假的。
# CLOUDFLARE_PROXY=true
# CF 之外的代理 / CDN 出口段（云 LB、其它 CDN），逗号分隔。
# 落在这些段里的地址永不会被自动封禁——那不是访客，是基础设施。
# IP_ACCESS_PROXY_RANGES=198.51.100.0/24
# 访问来源统计（平台页「谁在打我」）。数据在 Redis 滚动，重启归零。
# IP_ACCESS_TRAFFIC_STATS=false

# 按 IP 限流。封禁只对少数固定 IP 有效，限流才是对付「很多 IP 各来一点」的工具。
# 默认 log_only：阈值定错会把真实用户挡在门外，先看几天日志再切 enforce。
# IP_ACCESS_RATE_LIMIT_ENABLED=false
# IP_ACCESS_RATE_LIMIT_MODE=enforce
# 每分钟每 IP 的上限，0 = 该档不限。default 定得宽是因为共享出口
#（公司 NAT、咖啡馆）后面可能有几十个真实用户。
# IP_ACCESS_RATE_LIMIT_AUTH_PER_MINUTE=20
# IP_ACCESS_RATE_LIMIT_PUBLIC_PER_MINUTE=30
# IP_ACCESS_RATE_LIMIT_DEFAULT_PER_MINUTE=600
# 自动封禁（登录爆破）：TTL 分钟数 / 触发阈值 / 计数窗口
# IP_ACCESS_AUTO_BAN_MINUTES=60
# IP_ACCESS_LOGIN_FAILURE_THRESHOLD=10
# IP_ACCESS_LOGIN_FAILURE_WINDOW_MINUTES=15
# nginx geo 片段导出路径（容器内）；空则不导出，全部判定留在应用层
# IP_ACCESS_NGINX_EXPORT_PATH=/data/ip-access/blocklist.conf

# 单租户部署（默认关闭）：禁止新建租户；自助注册加入默认租户
# SINGLE_TENANT=true

# 平台通配子域基域：{slug}.{TENANT_BASE_DOMAIN} 自动锁定租户（需通配 DNS + 证书）
# TENANT_BASE_DOMAIN=rewindom.example.com

# 自定义域 TLS：平台控制台「签发证书」调用宿主机 ACME helper（bootstrap/deploy 安装）
# helper 听 0.0.0.0:9370，iptables 只放行回环 + RFC1918（Docker）；勿对公网开放 9370
# ACME_HELPER_URL=http://host.docker.internal:9370
# ACME_HELPER_TOKEN=your-random-token

# 运行时（可选覆盖；compose 有默认）
# LOG_LEVEL=warn
# FRONTEND_URL=https://rewindom.example.com
# PLATFORM_URL=https://admin.rewindom.example.com

# REDIS_PASSWORD=

# ---- 发信通道（平台默认；租户可在 /app/mailer 覆盖其中任意字段）----
# 不配就是「本部署没有发信能力」：依赖发信的功能会把入口收起来，而不是收下请求再发不出去。
# 生产禁止 MAIL_DRIVER=log（那会让所有邮件静默消失），config.ts 启动即拒。
# MAIL_DRIVER=smtp
# 发件人必须是你能证明所有权的域名，收件方按它校验 SPF/DKIM
# MAIL_FROM=Rewindom <noreply@example.com>
# Resend 走 SMTP 中继：host=smtp.resend.com、user=resend、password=API key（re_…）
# MAIL_SMTP_HOST=smtp.resend.com
# 465 = 隐式 TLS（MAIL_SMTP_SECURE=true）；587 = STARTTLS（必须 false）
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_USER=resend
# MAIL_SMTP_PASSWORD=

# Resend 原生通道（MAIL_DRIVER=resend）。比 SMTP 中继多拿到的是**退信与投诉回调**——
# SMTP 是「交出去就结束」的协议，送达率掉了也看不见。
# MAIL_RESEND_API_KEY=
# 回调验签密钥（Resend 控制台的 whsec_…）。回调地址全站一个、没有租户上下文，
# 所以只能放平台级。留空 = 不接回调（验签一律失败，不是静默放行）。
# 回调地址：https://<你的域名>/api/public/mailer/webhook
# MAIL_WEBHOOK_SECRET=

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-flash

# 向量模型（事件语义聚类用）。与上面的对话模型是**两个供应商**：
# OPENAI_BASE_URL 指向 deepseek，而 deepseek 没有 embeddings 端点。
# 不配 = 聚类退回纯词面判据，功能不缺失，只是合并率低。
# OPENAI_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_MODEL=embedding-3
# OPENAI_EMBEDDING_DIMENSIONS=1536

# 文件存储（默认本地磁盘）。生产接到 Cloudflare R2：
# ATTACHMENT_STORAGE=r2
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=rewindom-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 公开读：r2.dev 或自定义媒体域（不要尾斜杠）。不设则由应用转发字节。
# S3_PUBLIC_BASE_URL=https://media.example.com

# ── user ──────────────────────────────────────────────────────
# OAuth（可选；配置后登录页显示对应按钮）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://rewindom.example.com/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://rewindom.example.com/api/auth/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=https://rewindom.example.com/api/auth/oauth/microsoft/callback
# MICROSOFT_AUTHORITY=common

# ── platform ──────────────────────────────────────────────────
# 平台管理员（compose → app 容器；请在 PLATFORM_URL 上登录）
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=change-me-in-production

# ── billing ───────────────────────────────────────────────────
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_STORE_ID=sto_1xa3pu52PWClO5EruTHs86
# CREEM_SERVER=prod
# CREEM_PRODUCT_MAP={"starter":"prod_xxx","pro":"prod_yyy","business":"prod_zzz"}

# ── shop ──────────────────────────────────────────────────────
# Stripe 商店收款（站点设置可覆盖）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ── events ────────────────────────────────────────────────────
# 采集开关。多实例部署时只让一个实例开，可省掉重复抓取（写入本身是幂等的）
# EVENTS_INGEST_ENABLED=true
# 采集周期（分钟，5 ~ 1440）
# EVENTS_INGEST_INTERVAL_MINUTES=15
# 分析器：auto = 配了 OPENAI_API_KEY 就走 LLM，否则走规则实现
# EVENTS_ANALYZER=auto
# 省钱闸门（只影响走 LLM 的站点，规则实现不受影响）
# 这三项必须写成数字：compose 透传空串时 Number("")===0，对 TOP_EVENTS / COOLDOWN
# 来说 0 = 不限 / 不冷却，等于把闸门整组关掉。
EVENTS_LLM_MIN_SIGNALS=2
EVENTS_LLM_TOP_EVENTS=30
EVENTS_LLM_COOLDOWN_MINUTES=30
# 窄分类调用：每站每轮最多几次，每个事件终生一次。
# 注意 0 在这一项上是「关掉」，与上面两项的 0（不限 / 不冷却）相反——
# 会花钱的键，失效方向要落在省钱那一侧。
EVENTS_LLM_CLASSIFY_PER_ROUND=40
# 每站每轮最多送几条未归属信号去聚类。只决定积压多久摊平，不是持续成本。
# EVENTS_PENDING_CLUSTER_LIMIT=500
# 语料保留期（天）。被关注过的事件一律豁免，无论多旧。
# EVENTS_SIGNAL_RETENTION_DAYS=90
# EVENTS_EVENT_RETENTION_DAYS=180

# 本地命令:
#   pnpm bootstrap -- --env production
#   pnpm deploy -- --env production
#   pnpm release patch -- --deploy-local --env production

# ---------------------------------------------------------------- 备份 / 部署
# 备份异地副本。不设的话备份只躺在本机，机器故障时数据和备份一起没。
# 支持 s3://（需 aws cli）或 rclone 远端（需 rclone）。
# 配了却推不上去，backup.sh 会直接失败退出——静默的异地备份等于没有。
# BACKUP_OFFSITE_DEST=s3://my-bucket/rewindom/production

# 容器名前缀。prod 与 test 部署在同一台机器上时必须区分，否则 container_name 撞车。
# 由部署脚本按环境自动写入（production=rewindom，test=rewindom-test），
# 手工跑 docker compose 时才需要自己设。
# CONTAINER_PREFIX=rewindom
