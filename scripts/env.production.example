# 生产环境 — 复制为仓库根目录 .env.production（勿提交）
# 本机：SSH 凭证 + Docker 部署密钥；服务器：由部署脚本写入对应 .env.production

# ── SSH（本机专用，永不上传服务器） ───────────────────────────
DEPLOY_HOST=123.45.67.89
DEPLOY_SSH_USER=root
DEPLOY_SSH_PASSWORD=your-password

# ── 域名与端口 ─────────────────────────────────────────────────
APP_DOMAIN=water.example.com
APP_PORT=3700
SSL_EMAIL=you@example.com
# 产品站 = 默认租户 CMS（Host 隐式绑定 default）。平台控制台必须另 Host。
# PLATFORM_URL / PLATFORM_HOST 默认 platform.${APP_DOMAIN}（需 DNS + 证书）。
# PLATFORM_URL=https://platform.water.example.com
# PLATFORM_HOST=platform.water.example.com

# ── 应用密钥（首次部署必填） ───────────────────────────────────
DB_PASSWORD=your-db-password
JWT_SECRET=your-64-char-random-jwt-secret
TENANT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 平台管理员（compose → app 容器；请在 PLATFORM_URL 上登录）
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=change-me-in-production

# 单租户部署（默认关闭）：禁止新建租户；自助注册加入默认租户
# SINGLE_TENANT=true

# 平台通配子域基域：{slug}.{TENANT_BASE_DOMAIN} 自动锁定租户（需通配 DNS + 证书）
# TENANT_BASE_DOMAIN=water.example.com

# 运行时（可选覆盖；compose 有默认）
# LOG_LEVEL=warn
# FRONTEND_URL=https://water.example.com
# PLATFORM_URL=https://platform.water.example.com

# OAuth（可选；配置后登录页显示对应按钮）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://water.example.com/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://water.example.com/api/auth/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=https://water.example.com/api/auth/oauth/microsoft/callback
# MICROSOFT_AUTHORITY=common

# ── 可选：LLM / Redis / Creem 付款 ────────────────────────────
# REDIS_PASSWORD=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-flash
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_STORE_ID=sto_1xa3pu52PWClO5EruTHs86
# CREEM_SERVER=prod
# CREEM_PRODUCT_MAP={"starter":"prod_xxx","pro":"prod_yyy","business":"prod_zzz"}

# 本地命令:
#   pnpm bootstrap -- --env production
#   pnpm deploy -- --env production
#   pnpm release patch -- --deploy-local --env production
