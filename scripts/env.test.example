# 测试环境 — 复制为仓库根目录 .env.test（勿提交）

# ── SSH（本机专用） ───────────────────────────────────────────
DEPLOY_HOST=123.45.67.89
DEPLOY_SSH_USER=root
DEPLOY_SSH_PASSWORD=your-password

# ── 域名与端口 ─────────────────────────────────────────────────
APP_DOMAIN=test.example.com
APP_PORT=3702
SSL_EMAIL=you@example.com

# ── 应用密钥 ───────────────────────────────────────────────────
DB_PASSWORD=your-db-password
JWT_SECRET=your-64-char-random-jwt-secret
TENANT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OPENAI_API_KEY=

# OAuth（可选）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://test.example.com/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://test.example.com/api/auth/oauth/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=https://test.example.com/api/auth/oauth/microsoft/callback
# MICROSOFT_AUTHORITY=common

# Creem 付款（billing）
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_STORE_ID=sto_1xa3pu52PWClO5EruTHs86
# CREEM_SERVER=test
# CREEM_PRODUCT_MAP={"starter":"prod_xxx","pro":"prod_yyy","business":"prod_zzz"}

# Stripe 商店收款（shop 模块；站点设置可覆盖）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# 本地命令:
#   pnpm bootstrap -- --env test
#   pnpm deploy -- --env test
