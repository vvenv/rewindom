// packages/server-kernel/prisma/kernel.prisma
// 由 apps/server/prisma/models/kernel.prisma 符号链接汇入
// 租户（多租户 SaaS）
model Tenant {
  id                   String    @id @default(uuid())
  slug                 String    @unique
  name                 String
  remark               String?
  /// 租户自定义域名（规范化小写 hostname，无 scheme/port）；全局唯一
  custom_domain        String?   @unique
  status               String    @default("active")
  plan                 String    @default("free")
  plan_since           DateTime?
  plan_ends_at         DateTime?
  onboarding_completed Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  settings  TenantSetting[]
  users     User[]
  api_keys  TenantApiKey[]
  roles     Role[]
}

model TenantApiKey {
  id           String    @id @default(uuid())
  tenant_id    String
  name         String
  key_prefix   String
  key_hash     String
  created_by   String
  created_at   DateTime  @default(now())
  revoked_at   DateTime?
  last_used_at DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([key_hash])
}

model TenantSetting {
  tenant_id  String
  key        String
  value      Json?
  secret     String?
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, key])
}

// 用户
model User {
  id                    String    @id @default(uuid())
  tenant_id             String
  username              String
  /// bcrypt 哈希；OAuth 专用账号可为 null（仅第三方登录）
  password              String?
  is_system_admin       Boolean   @default(false)
  enabled               Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  last_login_at         DateTime?
  last_access_at        DateTime?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  tenant          Tenant           @relation(fields: [tenant_id], references: [id])
  refresh_tokens  RefreshToken[]
  oauth_accounts  OAuthAccount[]
  user_roles      UserRole[]
  audit_logs      AuditLog[]
  background_jobs BackgroundJob[]
  notifications   Notification[]

  // 复合主键是 [tenant_id, user_id]，从 Prisma 看不是 1-1（user_id 本身没 unique），
  // 因此声明为列表；实际每个用户在其所属租户下至多一行。
  dashboard_preferences DashboardPreference[]

  @@unique([tenant_id, username])
  @@index([tenant_id])
}
