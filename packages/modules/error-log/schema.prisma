// packages/modules/error-log/schema.prisma
// 由 apps/server/prisma/models/error-log.prisma 符号链接汇入
model ErrorLog {
  id             String   @id @default(uuid())
  level          String
  message        String
  stack_trace    String?
  user_id        String?
  username       String?
  tenant_slug    String?
  route          String?
  method         String?
  ip_address     String?
  user_agent     String?
  request_body   Json?
  request_params String?
  request_query  String?
  error_code     String?
  context        String?
  created_at     DateTime @default(now())

  @@index([user_id])
  @@index([tenant_slug])
  @@index([level])
  @@index([created_at])
  @@index([error_code])
  // jsonb_path_ops：只支持 @> / @? / @@（containment + jsonpath），
  // 但索引体积约为默认 jsonb_ops 的 1/3——日志表持续增长，优先选小的。
  // 若需要键存在查询（? / ?| / ?&），改成 ops: JsonbOps。
  @@index([request_body(ops: JsonbPathOps)], type: Gin)
}
