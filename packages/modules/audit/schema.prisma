// packages/modules/audit/schema.prisma
// 由 apps/server/prisma/models/audit.prisma 符号链接汇入
model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?
  username    String
  tenant_slug String?
  scope       String   @default("tenant")
  action      String
  resource    String?
  details     String?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([tenant_slug])
  @@index([scope])
  @@index([action])
  @@index([created_at])
}
