// packages/modules/notes/schema.prisma
// 由 apps/server/prisma/models/notes.prisma 符号链接汇入
// --- module: notes ---
// 刻意**不**声明到 Tenant 的 relation：那会让业务模块反向依赖 platform 模块的表，
// 违背模块单向依赖。租户隔离由 tenant-guard 扩展在查询层自动注入 tenant_id 保证
// （见 server-kernel/lib/tenant-guard.ts 的 MODEL_POLICIES）。gen:module 生成的
// 模块同理，todos 也是这个形状。
model Note {
  id         String   @id @default(uuid())
  tenant_id  String
  title      String
  content    String   @default("")
  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([tenant_id, updated_at])
}
