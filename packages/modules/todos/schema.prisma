// packages/modules/todos/schema.prisma
// 由 apps/server/prisma/models/todos.prisma 符号链接汇入
// --- module: todos ---
model Todo {
  id         String   @id @default(uuid())
  tenant_id  String
  title String
  completed Boolean @default(false)
  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
  @@index([tenant_id, completed, updated_at])
}
