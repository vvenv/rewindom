// packages/builtin/notification/schema.prisma
// 由 apps/server/prisma/models/notification.prisma 符号链接汇入
model Notification {
  id         String    @id @default(uuid())
  tenant_id  String
  user_id    String
  type       String
  severity   String
  title      String
  body       String
  link_path  String?
  metadata   Json?
  dedupe_key String?
  read_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, dedupe_key])
  @@index([tenant_id, user_id, read_at, created_at])
  @@index([tenant_id, user_id, created_at])
  @@index([created_at])
}

model NotificationLog {
  id             String   @id @default(uuid())
  tenant_id      String
  channel        String
  alert_type     String
  alert_severity String
  message        String
  success        Boolean
  error_message  String?
  created_at     DateTime @default(now())

  @@index([tenant_id, created_at])
  @@index([channel, created_at])
  @@index([alert_type, created_at])
  @@index([alert_severity, created_at])
}
