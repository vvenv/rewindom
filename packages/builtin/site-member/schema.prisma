// packages/modules/site-member/schema.prisma
// 由 apps/server/prisma/models/site-member.prisma 符号链接汇入
// --- module: site-member ---
// 站点会员是「租户的终端客户」，与工作台用户（User）是不同的身份主体：
// 独立表 + 独立 refresh token 表，对标 PlatformAdmin / PlatformAdminRefreshToken。
// 刻意不声明到 Tenant 的 relation：租户隔离由 tenant-guard + withTenantScope 保证。

model SiteMember {
  id                    String    @id @default(uuid())
  tenant_id             String
  email                 String
  // 预留 null 以便后续接入第三方登录（当前仅密码登录）
  password              String?
  display_name          String    @default("")
  // 仓库尚无邮件发送能力，注册时不校验邮箱；接入后由验证流程回填
  email_verified_at     DateTime?
  enabled               Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  last_login_at         DateTime?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  refresh_tokens SiteMemberRefreshToken[]
  oauth_accounts SiteMemberOAuthAccount[]
  oauth_exchange_codes SiteMemberOAuthExchangeCode[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
}

model SiteMemberRefreshToken {
  id         String   @id @default(uuid())
  member_id  String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  revoked    Boolean  @default(false)

  member SiteMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
}

/// 会员第三方登录绑定（按站点租户隔离：同一 GitHub 可在不同站点各有一份会员）。
model SiteMemberOAuthAccount {
  id                 String   @id @default(uuid())
  tenant_id          String
  member_id          String
  provider           String
  provider_user_id   String
  provider_email     String?
  provider_username  String?
  avatar_url         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  member SiteMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, provider, provider_user_id])
  @@index([member_id])
  @@index([tenant_id])
}

/// 会员 OAuth 回调后的一次性换票码（固定主域回调 → 跳回 custom_domain 种 Cookie）。
model SiteMemberOAuthExchangeCode {
  id          String    @id @default(uuid())
  code        String    @unique
  tenant_id   String
  member_id   String
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  member SiteMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@index([tenant_id])
  @@index([expires_at])
}
