// packages/builtin/dashboard/schema.prisma
// 由 apps/server/prisma/models/dashboard.prisma 符号链接汇入
//
// 用户级工作台布局。一个用户在一个租户下一行；从未配置过的用户没有行，
// 读取时返回空偏好（= 跟随各模块声明的默认顺序，全部可见）。
model DashboardPreference {
  tenant_id  String
  user_id    String
  /// 用户显式隐藏的卡片 id
  hidden_widgets String[]
  /// 用户自定义顺序；不在其中的卡片按模块默认 order 排在其后
  widget_order   String[]
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([tenant_id, user_id])
}
