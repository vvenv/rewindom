// packages/modules/audit/schema.prisma
// 由 apps/server/prisma/models/audit.prisma 符号链接汇入
model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?
  username    String
  tenant_slug String?
  scope       String   @default("tenant")
  action      String
  resource    String?
  /** 遗留纯文本，或 detail_key 渲染出的 zh-CN 检索副本 */
  details     String?
  /** 稳定模板 code，如 notes.audit.created；与 detail_params 成对 */
  detail_key  String?
  detail_params Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([tenant_slug])
  @@index([scope])
  @@index([action])
  @@index([detail_key])
  @@index([created_at])
}
