// packages/modules/marketing/schema.prisma
// 由 apps/server/prisma/models/marketing.prisma 符号链接汇入
// --- module: marketing ---
// 刻意不声明到 Tenant 的 relation：租户隔离由 tenant-guard + withTenantScope 保证。

model MarketingSite {
  id             String   @id @default(uuid())
  tenant_id      String   @unique
  // 纯字符串（单语言）或 { __i18n: { [locale]: text } }（同页头文案）
  site_name      Json
  tagline        Json     @default("\"\"")
  // 品牌相关（logo / 主色 / 字体 / 版式）统一放 theme_settings，不再单独开列
  theme_settings Json     @default("{}")
  default_locale String   @default("zh-CN")
  nav_json       Json     @default("[]")
  footer_json    Json     @default("[]")
  nav_draft_json Json     @default("[]")
  footer_draft_json Json  @default("[]")
  published      Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([tenant_id])
}

model MarketingPage {
  id          String   @id @default(uuid())
  tenant_id   String
  slug        String
  locale      String   @default("zh-CN")
  kind        String   @default("page")
  // 正文四件套：无后缀的是线上（访客看到的），`_draft` 的是编辑器在改的那一份
  title             String
  description       String   @default("")
  sections          Json     @default("[]")
  settings          Json     @default("{}")
  title_draft       String
  description_draft String   @default("")
  sections_draft    Json     @default("[]")
  settings_draft    Json     @default("{}")
  // public = 所有人可见；members = 需站点会员登录（公开端点只返回摘要）
  visibility  String   @default("public")
  status      String   @default("draft")
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, slug, locale])
  @@index([tenant_id])
  @@index([tenant_id, status, kind])
}

/**
 * 公开表单的一次提交。
 *
 * 内容存成自描述的 `[{ id, label, value }]` 而不是 `{ fieldId: value }`：字段是 block，
 * 租户随时会改标题、删字段、调顺序——按 id 存的话，三个月后回头看后台列表只剩一堆
 * uuid 对不上任何东西。存下提交**当时**的标签，历史记录才读得懂。
 */
model MarketingFormSubmission {
  id          String   @id @default(uuid())
  tenant_id   String
  // 定位到哪个表单；段可能被删或改，所以标题另存一份快照
  page_slug   String
  page_locale String
  section_id  String
  form_title  String   @default("")
  data        Json     @default("[]")
  // 溯源与反垃圾
  ip          String   @default("")
  user_agent  String   @default("")
  created_at  DateTime @default(now())

  @@index([tenant_id, created_at])
  @@index([tenant_id, section_id])
}

/**
 * 站内 301/302 重定向。
 *
 * 迁站、改 slug、下线活动页时用来保住外部链接与既有排名。按 `from_path` 精确匹配，
 * **不**做通配/正则：通配规则写错的后果是整站进重定向循环，而这类规则又恰恰最难在
 * 编辑器里看出对不对。真需要批量时，多加几条明确的记录比一条聪明的规则可靠。
 */
model MarketingRedirect {
  id          String   @id @default(uuid())
  tenant_id   String
  /** 源路径，站内绝对路径（`/old-pricing`）；同租户唯一。 */
  from_path   String
  /** 目标：站内路径或 http(s) 绝对地址。 */
  to_path     String
  /** 301 永久（默认，会被浏览器与搜索引擎缓存）/ 302 临时。 */
  status_code Int      @default(301)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, from_path])
  @@index([tenant_id])
}

/**
 * 媒体库里的一张图。
 *
 * 以前上传只落盘、不落库：URL 一旦从编辑器里删掉，那个文件就再也找不回来，也没人知道
 * 它还在不在被引用。有了这行才谈得上「列出来、复用、删掉、写 alt」。
 *
 * `alt` 存在这里而不是随每个引用点存一份：同一张图在十个地方用，无障碍文案不该抄十遍。
 */
model MarketingAsset {
  id          String   @id @default(uuid())
  tenant_id   String
  /** 落盘文件名（`<id><ext>`），也是公开 URL 的最后一段。 */
  filename    String
  mime_type   String
  size_bytes  Int
  /** 原始像素尺寸；解析不出来时为 0（SVG 没有固有尺寸）。 */
  width       Int      @default(0)
  height      Int      @default(0)
  /** 无障碍替代文本；空表示装饰性图片。 */
  alt         String   @default("")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, filename])
  @@index([tenant_id, created_at])
}

/**
 * 页面正文的一次发布快照。
 *
 * 现有的草稿 / 线上两列只回答「有没有未发布的改动」，答不了「上周三线上是什么样」。
 * 每次发布存一份，才谈得上回滚到任意一版——而不是只能撤销到最近一次发布。
 *
 * 存**完整正文**而不是 diff：正文是一棵 section 树，逐版存 diff 要在读取时按序重放，
 * 中间任何一版损坏就全线报废；而一页正文才几十 KB，直接存整份换来的是「任何一版都能
 * 独立读出来」。
 */
model MarketingPageVersion {
  id          String   @id @default(uuid())
  tenant_id   String
  page_id     String
  /** 同一页内自增，从 1 开始；展示与排序都用它，不用时间戳。 */
  version     Int
  title       String
  description String   @default("")
  sections    Json     @default("[]")
  settings    Json     @default("{}")
  /** 触发这次发布的用户，供「谁改的」一列。 */
  created_by  String   @default("")
  created_at  DateTime @default(now())

  @@unique([tenant_id, page_id, version])
  @@index([tenant_id, page_id, created_at])
}

/**
 * 文档库分类：稳定 key + 多语言显示名。
 *
 * 各语言版本的文档共用同一个 `key`（存在 `MarketingDoc.category`），显示名走
 * `label`（纯字符串或 `{ __i18n }`）。与「每语言各填一个分类名字符串」解耦。
 */
model MarketingDocCategory {
  id         String   @id @default(uuid())
  tenant_id  String
  key        String
  label      Json
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, key])
  @@index([tenant_id, sort_order])
}

/**
 * 租户文档库里的一篇文档。
 *
 * 与 `MarketingPage`（页面版式系统）解耦：文档就是「标题 + Markdown 正文」，
 * 不进 section / block 体系——文档作者只写 markdown，不碰 Theme Editor。每租户
 * 默认有一个 `/docs` 索引与 `/docs/:slug` 详情路由（见 `docs.routes.ts`），渲染
 * 复用站点 chrome + `.prose` 排版。
 *
 * 与平台文档（`docs/*.md`，代码版本化）的区别：平台文档跟代码走、给默认租户产品
 * 站用；本表是租户自管、DB 存储、按租户隔离。
 *
 * draft / live 两列与 `MarketingPage` 同口径：无后缀是线上（访客看到的），`_draft`
 * 是编辑器在改的那一份。`status` 为 `draft` 时文档对访客不可见（不出现在 `/docs`）。
 * `locale` 与页面同口径（翻译组 key = `(tenant, slug)`），v1 管理台只编辑站点主语言，
 * 非主语言回落主语言（整库回落，不逐篇 404）。
 *
 * 刻意不声明到 Tenant 的 relation：租户隔离由 tenant-guard + withTenantScope 保证。
 */
model MarketingDoc {
  id          String   @id @default(uuid())
  tenant_id   String
  slug        String
  locale      String   @default("zh-CN")
  // 已发布正文（访客看到的）
  title             String
  description       String   @default("")
  body_md           String   @default("")
  /** 分类 key，对应 `MarketingDocCategory.key`；空串表示未分类。 */
  category          String   @default("")
  sort_order        Int      @default(0)
  status            String   @default("draft")
  // 编辑器草稿（与 MarketingPage 同口径，发布时复制到无后缀列）
  title_draft       String
  description_draft String   @default("")
  body_md_draft     String   @default("")
  category_draft    String   @default("")
  sort_order_draft  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, slug, locale])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, category, sort_order])
}
