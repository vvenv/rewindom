{
  "name": "@rewindom/builtin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "assemble:marketing-css": "node marketing/shared/site-css/assemble.mjs",
    "assemble:section-icons": "node marketing/shared/section-icons/assemble.mjs",
    "assemble:site-enhance": "node marketing/shared/site-enhance/assemble.mjs",
    "assemble:site-fonts": "node marketing/shared/site-fonts/assemble.mjs",
    "assemble:module-css": "node scripts/assemble-module-css.mjs",
    "assemble": "pnpm assemble:marketing-css && pnpm assemble:section-icons && pnpm assemble:site-enhance && pnpm assemble:site-fonts && pnpm assemble:module-css",
    "pretest": "pnpm assemble",
    "pretypecheck": "pnpm assemble",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:section-css": "node marketing/shared/site-css/check-section-css.mjs"
  },
