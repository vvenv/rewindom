# 本地开发 — 复制为 .env.local（勿提交）
# 需要接近线上的数据：pnpm db:pull（勿直连生产库开发）
# 远程部署见 scripts/env.production.example；本地生产镜像验证见 scripts/env.docker.local.example

PORT=3700
HOST=0.0.0.0
LOG_LEVEL=info

# 数据库配置（与 docker-compose.dev.yml / 生产脚本统一：用户与库名均为 be-water）
# 若与本机 Postgres 冲突，Docker 默认映射 5433（见 docker-compose.dev.yml）
DATABASE_URL=postgresql://be-water:your-password@localhost:5433/be-water
DB_PASSWORD=your-password

# 本地 Docker：pnpm db:up 启动 Postgres + Redis（默认宿主机端口 5433，避免与本机 Postgres 冲突）
# POSTGRES_PORT=5433

# JWT 认证
JWT_SECRET=your-random-secret-key-at-least-32-characters-long

# 产品站（默认租户）与平台控制台 Host 分离：
# FRONTEND_URL=http://localhost:7300          → localhost 绑定 default
# PLATFORM_URL=http://127.0.0.1:7300          → 127.0.0.1 进 /platform
#
# OAuth 登录（对应 CLIENT_ID + CLIENT_SECRET 都配置后登录页显示按钮）
# 未设 *_CALLBACK_URL 时回退 FRONTEND_URL，再回退请求 Host
# FRONTEND_URL=http://localhost:7300
#
# OAuth：工作台与站点会员共用同一条 IdP Redirect URI（回调按 state.typ 分流）
# GitHub：Settings → Developer settings → OAuth Apps
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:7300/api/auth/oauth/github/callback
#
# Google：Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:7300/api/auth/oauth/google/callback
#
# Microsoft Entra：App registrations → Authentication → Redirect URIs
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK_URL=http://localhost:7300/api/auth/oauth/microsoft/callback
# MICROSOFT_AUTHORITY=common

# 平台系统管理员（独立于租户 User 表；登录时不加 @tenant）
# PLATFORM_ADMIN_USERNAME=platform
# PLATFORM_ADMIN_PASSWORD=change-me-in-production
# 或使用 bcrypt 哈希：PLATFORM_ADMIN_PASSWORD_HASH=

# 租户 secret 字段 AES-GCM 加密（32 字节，hex 64 字符或 base64）
# 必需（非测试环境）：租户密钥加密主密钥，32 字节 hex。
# 生成：openssl rand -hex 32
TENANT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 单租户部署（默认关闭）：保留 Tenant 模型，但禁止新建租户；
# 自助注册 / OAuth 首次登录一律加入默认租户；平台隐藏租户管理入口。
# SINGLE_TENANT=true

# 平台通配子域基域（可选）：{slug}.{TENANT_BASE_DOMAIN} 自动锁定租户
# TENANT_BASE_DOMAIN=water.example.com
#
# 本地想同时调多个租户的站点，把基域设成 localhost：
#   TENANT_BASE_DOMAIN=localhost
# 然后直接开 http://{slug}.localhost:7300 —— 浏览器原生把 *.localhost 解析到回环，
# 不用改 hosts。localhost 本身仍是默认租户，127.0.0.1 仍是平台控制台，互不影响。

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM — OpenAI 兼容接口（默认指向 DeepSeek）；按需由业务模块调用
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# Creem 付款（billing 模块；未配置 API Key 时 checkout 会明确报错）
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_STORE_ID=sto_1xa3pu52PWClO5EruTHs86
# CREEM_SERVER=test
# CREEM_PRODUCT_MAP={"starter":"prod_xxx","pro":"prod_yyy","business":"prod_zzz"}

# 运行环境
NODE_ENV=development
