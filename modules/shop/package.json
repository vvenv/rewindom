    "react-i18next": "^17.0.11",
    "stripe": "^20.0.0"
  },
  "peerDependencies": {
    "fastify": "^5.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "devDependencies": {
    "@rewindom/server-test": "workspace:*",
    "@rewindom/client-test": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "happy-dom": "^20.11.2",
    "msw": "^2.15.0",
