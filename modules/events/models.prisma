// 外部模块的 Prisma schema——由 gen:external-modules 符号链接到
// apps/server/prisma/models/events.prisma，汇入全局 schema。
// 放在模块根、叫 models.prisma：不要放进 prisma/schema.prisma，语言服务
// 会把它当成独立 schema 根，没有 datasource 时默认非 PostgreSQL，
// String[] / Float[] 会被误报成 connector 不支持。
//
// 归属口径：采集源、信号、事件、时间线都按站点隔离。各站点自管源与规则，
// 官网公开面只展示本站语料。关注（EventFollow）仍然是站点 + 用户态。

/// 采集源（RSS/Atom 订阅或内置 connector 的一条配置）。按站点隔离。
model EventFeed {
  id              String    @id @default(uuid())
  tenant_id       String
  /// connector 标识：hackernews | rss
  connector       String
  /// 展示名，如 "Hacker News"、"OpenAI Blog"
  name            String
  /// RSS/Atom 地址；hackernews 这类内置 connector 填其 API 根地址（仅作唯一键）
  url             String
  /// official | news | community —— 决定它在事件详情里被归到哪一组
  source_kind     String
  /// 该源默认归属的主题
  topic           String    @default("tech")
  enabled         Boolean   @default(true)
  last_fetched_at DateTime?
  /// 最近一次抓取失败的原因，成功后清空
  last_error      String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@unique([tenant_id, url])
  @@index([tenant_id, enabled, last_fetched_at])
}

/// 一条原始信号：某个源上的一篇帖子 / 一条新闻 / 一次发布公告。按站点隔离。
model EventSignal {
  id            String    @id @default(uuid())
  tenant_id     String
  connector     String
  /// 源内唯一 id（HN 的 item id、RSS 的 guid），与 connector 组成幂等键
  external_id   String
  source_name   String
  source_kind   String
  title         String
  url           String
  /// 去掉 utm / 锚点等噪声后的规范化 URL，跨源合并同一篇原文靠它
  canonical_url String
  excerpt       String    @default("")
  author        String?
  topic         String    @default("tech")
  /// 源上的热度指标（HN points / RSS 恒为 0）
  score         Int       @default(0)
  comment_count Int       @default(0)
  published_at  DateTime
  fetched_at    DateTime  @default(now())
  event_id      String?
  /// 状态页一条 incident 的完整更新序列（`{ occurred_at, phase, text }[]`）。
  /// Statuspage 把一次故障的全部更新塞在一个 description 里，而 truncateExcerpt
  /// 在 600 字截断——不在 connector 里就地解析，后半截就永远丢了。
  ///
  /// **不拆成多格时间线**：时间线格子的身份是 `(event_id, signal_id)`，
  /// 一次 incident 是一条信号，它的多次更新是这条信号的内部结构
  incident_updates Json?
  /// 工作台手动移除的时间。非空 = 这条信号不再参与任何聚合、也不再出现在任何面上。
  /// **不能硬删**：源下一轮还会把同一条抓回来，删了它等于每 15 分钟复活一次。
  /// 留着行本身就是墓碑——采集的身份键会命中它，于是不再重建（见 ingest.service.ts）。
  removed_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  event NewsEvent? @relation(fields: [event_id], references: [id], onDelete: SetNull)

  /// 源自己的幂等键。够用但**不充分**：源会给同一篇文章换 guid（BBC 的 RSS guid
  /// 带 `#0`/`#1` 修订号，文章更新后同一篇会以新 guid 再出现一次）
  @@unique([tenant_id, connector, external_id])
  /// 信号的**真实身份**：同一来源的同一篇原文只该有一条信号。
  /// 没有它，一篇被源改过稿的文章会在事件时间线上占两格，内容一模一样。
  /// 刻意带上 source_name —— 不同来源指向同一篇原文是**合法且有价值**的
  ///（跨源印证正是靠 canonical_url 相等来合并事件的）
  @@unique([tenant_id, connector, source_name, canonical_url])
  @@index([event_id, removed_at])
  @@index([event_id, published_at])
  @@index([tenant_id, published_at(sort: Desc)])
  @@index([tenant_id, canonical_url])
}

/// 由多条信号聚成的一个事件。按站点隔离。
model NewsEvent {
  id        String @id @default(uuid())
  tenant_id String
  /// 稳定可读标识，详情页 URL 与去重都用它；唯一约束含 tenant_id
  slug      String
  /// 聚类指纹与 slug 都基于它
  title     String
  /// 「发生了什么」——3~5 句
  summary   String @default("")
  topic     String @default("tech")
  /// developing | active | cooling | resolved
  status    String @default("developing")
  /// 聚类指纹：由 tokens 排序拼接而成，唯一约束顺手承担了「同指纹即同事件」的去重
  fingerprint String
  /// 立事件那条信号的标题词集合。新信号靠它算相似度决定并入还是另起一个事件；
  /// 刻意不随聚类扩张——否则词集会越滚越大，最后把所有事件吸成一个
  tokens      String[]
  /// 成员信号 embedding 的均值（语义聚类的判据）。空数组 = 还没有向量：
  /// 没配 OPENAI_EMBEDDING_* 或调用失败，此时聚类退回纯词面判据。
  /// 存 Float[] 而不上 pgvector：候选窗口实测只有几百个事件，ANN 索引要到
  /// 10^4 量级才有意义，而换 pgvector 镜像会把 Postgres 从 musl 换到 glibc，
  /// collation 提供者一变既有文本索引就得全量 REINDEX
  centroid    Float[]
  /// 贡献过信号的来源名（去重）。冗余在事件上，列表页才不用为每张卡片再查一次信号表
  source_names String[]
  /// 事件类型：outage | release | acquisition | funding | legal。
  /// **可空 = 判不出来**，不设 other 兜底格——语料里绝大多数是普通报道，
  /// 硬塞一个最像的会让整个类型筛选面失去意义（与 topic 分类器同一条原则）。
  /// 它是抽取的前提：不知道是哪一类就不知道该抽什么字段
  kind      String?
  /// 发版：原文里的版本号。展示用的永远是原串，可核对性最高
  fact_version          String?
  /// 收购 / 融资 / 法务：原文里的金额串，如 `$7B`、`$2.1 million`
  fact_amount_text      String?
  /// 同上，归一化到美元，**只为聚合**（「这家今年融了多少」）。
  /// 用 Float 而不是 shop 那套 `*_cents` 整数：这不是我们持有的钱，是来源报道的
  /// 近似量级；写成 cents 会暗示一种它没有的精度，而 $7B 的 cents 是 7e11，
  /// Int32 直接溢出。非美元一律留空——按汇率折算是引入来源外的事实
  fact_amount_usd       Float?
  /// 故障：由一手更新序列的首末时刻算出的持续分钟数。只有一格时是 null 而非 0
  fact_duration_minutes Int?
  /// 故障：一手更新序列的最后一格是不是收尾阶段。没有序列时 null 而非 false
  fact_resolved         Boolean?
  /// 贡献过信号的来源类型（去重）。与 source_names 同一处写入。
  /// Rising 要在库里过滤掉「只有非新闻源」的事件（release / status / filing
  /// 恒为单来源，进 Rising 只会把真正在扩散的挤下去），公开列表要按类型筛，
  /// 两者都不能把候选全捞回应用层再算
  source_kinds String[]
  /// 预计算的相关事件 id（最多 5 个，按相似度降序）。
  /// **必须预计算**：读路径上算要把候选的 centroid 全部载入（400 事件 ≈ 4.9MB/请求），
  /// 公开面 SSR 承受不起。做法与聚类同源，只是阈值更低（0.75 vs 0.85）
  related_event_ids String[]

  signal_count Int   @default(0)
  /// 贡献过信号的不同源数量——跨源程度，Rising 排序会用到
  source_count Int   @default(0)
  /// 最近窗口的加权热度
  heat_score   Float @default(0)
  /// 相对上一窗口的变化率（百分比）。**没有上一窗口时恒为 0**，见下一个字段
  velocity_pct Float @default(0)
  /// 上一窗口是否构成可比较的基线。false 时 velocity_pct 的 0 表示「还说不出来」，
  /// 不是「持平」——界面必须能区分这两者，否则新事件会被写成没有变化
  has_velocity_baseline Boolean @default(false)
  /// 近窗内的信号条数。Rising 的次级排序键
  recent_signal_count Int @default(0)
  /// 近窗内贡献过信号的不同来源数。Rising 的主排序键——
  /// 跨源印证是可核对的事实，比缺基线时硬算出来的比率更有资格排在首页
  recent_source_count Int @default(0)

  first_seen_at    DateTime
  last_activity_at DateTime
  /// 最近一次跑分析器的时间；null 表示还没生成过摘要
  analyzed_at      DateTime?
  /// heuristic | llm | manual —— 当前摘要/时间线由哪种分析器产出；manual 表示人工改过
  analyzer         String    @default("heuristic")
  /// 工作台改过标题或摘要后为 true：采集刷新仍更新热度与时间线，但不再覆盖文案
  manual_content   Boolean   @default(false)
  /// 工作台改过主题后为 true：分类器每轮重算主题，但不再覆盖人工指定的那个。
  /// 与 manual_content 分开——改主题不该顺带锁死摘要，改摘要也不该锁死主题
  manual_topic     Boolean   @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  signals   EventSignal[]
  timeline  EventTimelineEntry[]
  follows   EventFollow[]
  revisions EventRevision[]
  entities  EventEntityLink[]

  @@unique([tenant_id, slug])
  @@unique([tenant_id, fingerprint])
  @@index([tenant_id, status, last_activity_at(sort: Desc)])
  @@index([tenant_id, topic, last_activity_at(sort: Desc)])
  /// Rising 的排序键
  @@index([tenant_id, recent_source_count(sort: Desc), recent_signal_count(sort: Desc)])
  @@index([tenant_id, last_activity_at(sort: Desc)])
}

/// 事件里出现的实体（公司 / 产品 / 人物 / 地点）。按站点隔离。
///
/// 事件是易逝的，实体不是——关注「OpenAI」比关注一个 24h 后就凉的事件留存高得多，
/// 而实体页是稳定的聚合面（事件页只有一次索引机会）。
model EventEntity {
  id         String @id @default(uuid())
  tenant_id  String
  /// 展示名，保留原始大小写
  name       String
  /// company | product | person | place | org（规则实现分不出类型时一律 org）
  kind       String @default("org")
  /// 身份键：大小写与空白归一 + 去所有格。**不做别名合并**——
  /// 把 Meta 与 Facebook 合并需要外部知识，猜错比不合并更糟
  normalized String
  /// 实体页 URL 用的可读标识，与 NewsEvent.slug 同一套做法（slugify + id 短后缀）
  slug       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  links   EventEntityLink[]
  follows EventEntityFollow[]

  @@unique([tenant_id, kind, normalized])
  @@unique([tenant_id, slug])
  @@index([tenant_id, normalized])
}

/// 事件 ↔ 实体。按站点隔离。
model EventEntityLink {
  id        String @id @default(uuid())
  tenant_id String
  event_id  String
  entity_id String
  /// 该实体在这个事件的信号里被提到几次。排序权重，不是「重要性」的断言
  mention_count Int @default(1)
  created_at DateTime @default(now())

  event  NewsEvent   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  entity EventEntity @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@unique([event_id, entity_id])
  @@index([tenant_id, entity_id])
  @@index([event_id, mention_count(sort: Desc)])
}

/// 用户对实体的关注。站点 + 用户态。
///
/// 与关注事件的区别是**时间尺度**：事件 24h 后就凉，关注它第三天就没意义了；
/// 实体不会凉——关注「OpenAI」之后只要它再出现在任何事件里就有东西可推。
model EventEntityFollow {
  id        String @id @default(uuid())
  tenant_id String
  user_id   String
  entity_id String
  /// 用户最后一次「看到这里」的时间；之后新关联上的事件才算新
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  entity EventEntity @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, user_id, entity_id])
  @@index([tenant_id, user_id])
  @@index([entity_id])
}

/// 事件状态变化的一条观察记录。**只追加，永不更新**。
///
/// 它是这个模块唯一「越跑越值钱」的数据：竞品每轮重新聚类，没有连续观察记录，
/// 事后补算不出「自你上次看之后发生了什么」。随事件按站点隔离。
model EventRevision {
  id        String @id @default(uuid())
  tenant_id String
  event_id  String
  /// source_joined | status_changed | summary_rewritten | title_changed
  kind      String
  /// 变更前的最小快照，用于渲染 diff；source_joined 这类「新增」没有前值
  before    Json?
  after     Json
  occurred_at DateTime
  created_at  DateTime @default(now())

  event NewsEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)

  /// 重跑保护：refreshEvents 是幂等的，修订写入也必须是。
  /// 同一事件、同一类变更、同一时刻只该有一条
  @@unique([event_id, kind, occurred_at])
  @@index([tenant_id, event_id, occurred_at(sort: Desc)])
  @@index([tenant_id, occurred_at(sort: Desc)])
}

/// 事件时间线上的一格。随事件按站点隔离。
model EventTimelineEntry {
  id          String   @id @default(uuid())
  tenant_id   String
  event_id    String
  occurred_at DateTime
  /// 启发式分析器产出的稳定文案 code（客户端按 events ns 翻译）。
  /// LLM 下是角色徽章（timeline.role.*），可以与 label_text 同时有。
  label_code  String?
  /// LLM 分析器产出的「这条比前面多了什么」；规则实现恒为空
  label_text  String?
  source_kind String
  /// 这一格是谁贡献的，界面上直接显示（「10:17 Hacker News 出现讨论」）
  source_name String   @default("")
  signal_id   String?
  url         String?
  created_at  DateTime @default(now())

  event NewsEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([event_id, signal_id])
  @@index([event_id, occurred_at])
}

/// 用户对事件的关注。站点 + 用户态。
model EventFollow {
  id        String @id @default(uuid())
  tenant_id String
  user_id   String
  event_id  String
  /// 用户最后一次查看该事件详情的时间；与 last_activity_at 比较得出「有更新」
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  event NewsEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, user_id, event_id])
  @@index([tenant_id, user_id])
  @@index([event_id])
}
