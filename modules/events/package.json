{
  "name": "@rewindom/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server/index.js": "./server/index.ts",
    "./client/module.js": "./client/module.tsx",
    "./*": "./*"
  },
  "scripts": {
    "assemble:site-css": "node ../../packages/builtin/scripts/assemble-module-css.mjs events",
    "pretest": "pnpm assemble:site-css",
    "pretypecheck": "pnpm assemble:site-css",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rewindom/builtin": "workspace:*",
    "@rewindom/module-sdk": "workspace:*",
    "@rewindom/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.31.0",
    "react-i18next": "^17.0.11"
  },
  "peerDependencies": {
    "fastify": "^5.11.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "devDependencies": {
    "@rewindom/server-test": "workspace:*",
    "@rewindom/client-test": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "happy-dom": "^20.11.2",
    "msw": "^2.15.0",
    "vitest": "^4.1.10"
  },
  "rewindom": {
    "moduleId": "events",
    "prismaSchema": "./models.prisma",
    "requires": [
      "rbac",
      "audit",
      "marketing"
    ]
  }
}
