// modules/useless/prisma/schema.prisma
// 由 apps/server/prisma/models/useless.prisma 符号链接汇入（gen:external-modules 自动建链）
// --- module: useless ---
model Thing {
  id        String @id @default(uuid())
  tenant_id String

  /// text = 一句话；embed = 可交互的 HTML/CSS/JS（只在沙箱 iframe 里执行）
  kind String @default("text")
  /// 归档与列表上显示的名字。embed 必填；text 可空，正文自己就是标题
  title String @default("")
  /// 公开地址 `/:slug`。租户内唯一。
  slug String @default("")
  /// kind=text 的正文
  text String @default("")
  /// kind=embed 的 HTML 片段，可含 <style>/<script>。详情页直接注入；列表缩略图是它的缩小版
  html String @default("")
  /// 列表卡片用的截图 URL。空则列表用可交互物自己的缩小预览
  thumbnail String @default("")

  enabled    Boolean  @default(true)
  created_by String
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@index([tenant_id, enabled])
}
