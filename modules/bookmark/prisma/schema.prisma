// 外部模块的 Prisma schema——由 gen:external-modules 符号链接到
// apps/server/prisma/models/bookmark.prisma，汇入全局 schema。
// 刻意不声明到 Tenant 的 relation：租户隔离由 tenant-guard 自动注入。
model Bookmark {
  id          String   @id @default(uuid())
  tenant_id   String
  url         String
  /** URL 的主机名（去 www.），列表按站点筛选与卡片展示都用它，避免每次现算。 */
  host        String   @default("")
  title       String
  description String   @default("")
  created_by  String
  updated_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([tenant_id])
  // 默认排序是 updated_at desc，单列 tenant_id 索引挡不住排序开销。
  @@index([tenant_id, updated_at])
}
