upstream app_backend {
    server app:3700;
    keepalive 8;
}

# 仅平台控制台 Host 走静态 SPA；产品主域（APP_DOMAIN）与其它 Host 的 HTML 反代 Marketing SSR。
# PLATFORM_HOST / APP_DOMAIN 由 nginx 镜像 envsubst 注入（见 docker-compose web.environment）。
map $host $use_tenant_ssr {
    default 1;
    ${PLATFORM_HOST} 0;
    www.${PLATFORM_HOST} 0;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 100m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/html application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    location ~ ^/api/(documents|search) {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        gzip off;
    }

    location /api/ {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://app_backend;
        proxy_set_header Host $host;
    }

    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # 会员的登录 / 注册 / 我的账户：租户可排版的 SSR 模板页，必须进后端
    # （其余 /member/* —— OAuth 回调 —— 仍是 SPA）。
    # 必须与 `SITE_SSR_EXCEPTION_PATHS`（packages/builtin/marketing/shared/site-locale.ts）一致。
    location ~ ^/member/(login|register|account|billing)$ {
        error_page 418 = @tenant_ssr;
        if ($use_tenant_ssr = 1) {
            return 418;
        }
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
    }

    # 应用壳层路径：仍走 SPA，不进 Marketing SSR。
    # 必须与 `SITE_APP_PREFIXES`（packages/builtin/marketing/shared/site-locale.ts）保持一致。
    location ~ ^/(app|login|register|auth|member|platform)(/|$) {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
    }

    location @tenant_ssr {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 平台控制台 Host：静态 SPA（/ → index.html，前端可进 /platform）。
    location / {
        error_page 418 = @tenant_ssr;
        if ($use_tenant_ssr = 1) {
            return 418;
        }
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
    }

    # sitemap / robots：租户 Host 走 SSR；平台控制台 Host 若有静态文件则直接返回。
    location ~ ^/(sitemap\.xml|robots\.txt)$ {
        error_page 418 = @tenant_ssr;
        if ($use_tenant_ssr = 1) {
            return 418;
        }
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }
}
