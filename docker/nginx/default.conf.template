upstream app_backend {
    server app:3700;
    keepalive 8;
}

# 默认的 main 格式记的是 $remote_addr —— 在「宿主 nginx → 容器 nginx」的拓扑下
# 那**永远是宿主 nginx 的地址**，每一条日志的 IP 都一样，等于没记。
# 排查「谁在打我」时这份日志是第一手材料，必须记真实来源。
log_format app_access '$http_x_forwarded_for - $remote_user [$time_local] '
                      '"$request" $status $body_bytes_sent '
                      '"$http_referer" "$http_user_agent" '
                      'rt=$request_time uct=$upstream_connect_time '
                      'uht=$upstream_header_time urt=$upstream_response_time';

access_log /var/log/nginx/access.log app_access;

# IP 封禁名单（module-ip-access 导出，占位由 20-ip-access-stub.sh 保证存在）。
#
# 用 `geo` 而不是堆 `deny`：前者是基数树，查一次与条数无关；后者是线性表，
# 几千条就会拖慢每个请求。
#
# 这一层的意义在于它能拦到**应用层拦不到的东西**：静态资源由 nginx 直出，
# 根本不进 Node。名单的真相源与实时判定仍在应用层，这里是冗余执行路径，
# 变更要等下一次 nginx reload 才生效。
include /etc/nginx/ip-access/blocklist.conf;

# 仅平台控制台 Host 走静态 SPA；产品主域（APP_DOMAIN）与其它 Host 的 HTML 反代 Marketing SSR。
# PLATFORM_HOST / APP_DOMAIN 由 nginx 镜像 envsubst 注入（见 docker-compose web.environment）。
map $host $use_tenant_ssr {
    default 1;
    ${PLATFORM_HOST} 0;
    www.${PLATFORM_HOST} 0;
}

# 本容器只监听 80，TLS 在外层反代（宿主 nginx / 云 LB）终止，所以 `$scheme` 恒为 http。
# 直接 `proxy_set_header X-Forwarded-Proto $scheme` 会把外层传进来的 https **覆盖**成
# http，后端据此拼出的 canonical / og:image / sitemap 全是 `http://`——社媒抓取方会
# 因协议不符丢掉 og:image，搜索引擎拿到的也是错的规范地址。
# 有外层给值就沿用，没有（或值不认识）才回退 $scheme。
# 端口只绑 127.0.0.1（见 docker-compose.prod.yml），这个头到不了外网客户端手里。
map $http_x_forwarded_proto $forwarded_proto {
    default   $scheme;
    "https"   https;
    "http"    http;
    # 多级代理会拼成 "https, http"，取第一段
    "~*^https" https;
}

server {
    listen 80;
    server_name _;

    # server 级 `if` + `return` 是官方认可的两种安全用法之一。
    # 放在最前：命中就不必再走 try_files / 反代。
    if ($ip_access_blocked) {
        return 403;
    }

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 100m;

    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    # text/html 是 nginx 恒含项，再列一次会在每次启动刷 duplicate MIME 警告
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    location ~ ^/api/(documents|search) {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        gzip off;
    }

    location /api/ {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # 自定义域签发证书会同步等 Certbot（可达 2 分钟）
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location = /health {
        proxy_pass http://app_backend;
        proxy_set_header Host $host;
    }

    location = /ready {
        proxy_pass http://app_backend;
        proxy_set_header Host $host;
    }

    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # 店面：整段 /shop/* 走 Fastify SSR（不能只精确匹配 /shop，否则详情页会掉进 CMS）。
    # 必须写在应用壳层 location 之前。
    location ~ ^/shop(/|$) {
        # 应用壳层 CSP（构建时按内联脚本 hash 生成）。只有 nginx 直出 HTML 的
        # location 挂它；命中 418 转 @tenant_ssr 时这里的 add_header 不生效，
        # 那条响应的策略由应用自己发。
        include /etc/nginx/csp-app.conf;
        error_page 418 = @tenant_ssr;
        if ($use_tenant_ssr = 1) {
            return 418;
        }
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    # 会员的登录 / 注册 / 我的账户 / 我的订单：租户可排版的 SSR 模板页，必须进后端
    # （其余 /member/* —— OAuth 回调 —— 仍是 SPA）。
    # 必须与 `SITE_SSR_EXCEPTION_PATHS`（packages/builtin/marketing/shared/site-locale.ts）一致。
    location ~ ^/member/(login|register|account|billing|orders)$ {
        # 应用壳层 CSP（构建时按内联脚本 hash 生成）。只有 nginx 直出 HTML 的
        # location 挂它；命中 418 转 @tenant_ssr 时这里的 add_header 不生效，
        # 那条响应的策略由应用自己发。
        include /etc/nginx/csp-app.conf;
        error_page 418 = @tenant_ssr;
        if ($use_tenant_ssr = 1) {
            return 418;
        }
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    # 应用壳层路径：仍走 SPA，不进 Marketing SSR。
    # 必须与 `SITE_APP_PREFIXES`（packages/builtin/marketing/shared/site-locale.ts）保持一致。
    #
    # 不能写成 `try_files $uri /index.html`：末项会内部重定向到 `/index.html`，
    # 再被下面的 `location /` 接住。租户 Host 上那条 location 会反代 Marketing SSR，
    # 于是 `/login` `/app` 变成官网 404，而不是 React 壳。
    location ~ ^/(app|login|register|auth|member|platform|shop)(/|$) {
        # 应用壳层 CSP（构建时按内联脚本 hash 生成）。只有 nginx 直出 HTML 的
        # location 挂它；命中 418 转 @tenant_ssr 时这里的 add_header 不生效，
        # 那条响应的策略由应用自己发。
        include /etc/nginx/csp-app.conf;
        try_files $uri @spa;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    location @spa {
        # 这个 location 原本一条 add_header 都没有，靠继承 server 级那组安全头。
        # 一旦下面 include 了带 add_header 的 CSP，继承就整组失效——必须把
        # security-headers 也显式 include 回来。
        include /etc/nginx/security-headers.conf;
        # 应用壳层 CSP（构建时按内联脚本 hash 生成）。只有 nginx 直出 HTML 的
        # location 挂它；命中 418 转 @tenant_ssr 时这里的 add_header 不生效，
        # 那条响应的策略由应用自己发。
        include /etc/nginx/csp-app.conf;
        try_files /index.html =404;
    }

    location @tenant_ssr {
        proxy_pass http://app_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # 平台控制台 Host：静态 SPA（/ → index.html，前端可进 /platform）。
    location / {
        # 应用壳层 CSP（构建时按内联脚本 hash 生成）。只有 nginx 直出 HTML 的
        # location 挂它；命中 418 转 @tenant_ssr 时这里的 add_header 不生效，
        # 那条响应的策略由应用自己发。
        include /etc/nginx/csp-app.conf;
        error_page 418 = @tenant_ssr;
        if ($use_tenant_ssr = 1) {
            return 418;
        }
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    # sitemap / robots / manifest：租户 Host 走 SSR；平台控制台 Host 若有静态文件则直接返回。
    location ~ ^/(sitemap\.xml|robots\.txt|site\.webmanifest)$ {
        error_page 418 = @tenant_ssr;
        if ($use_tenant_ssr = 1) {
            return 418;
        }
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
}
