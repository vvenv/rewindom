{
  "name": "@rewindom/server",
  "version": "0.7.8",
  "private": true,
  "type": "module",
  "exports": {
    "./test": "./src/test/index.ts",
    "./enabled-modules": "./src/enabled-modules.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @rewindom/builtin assemble",
    "build": "tsc -p tsconfig.build.json --noEmit && node scripts/bundle.mjs",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "validate:module-deps": "tsx scripts/validate-module-dependencies.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --coverage --run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/caching": "^9.0.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@napi-rs/canvas": "^1.0.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@rewindom/bookmark": "workspace:*",
    "@rewindom/builtin": "workspace:*",
    "@rewindom/events": "workspace:*",
    "@rewindom/note": "workspace:*",
    "@rewindom/server-kernel": "workspace:*",
    "@rewindom/shared": "workspace:*",
    "@rewindom/shop": "workspace:*",
    "@rewindom/site-docs": "workspace:*",
    "@rewindom/site-form": "workspace:*",
    "@rewindom/todo": "workspace:*",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "openai": "^7.5.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "stream-json": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "thread-stream": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rewindom/builtin": "workspace:*",
    "@rewindom/server-test": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/stream-json": "^1.7.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
